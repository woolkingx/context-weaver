{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-weaver/owners/skill.schema.json",
  "title": "Skill owner FileBlock value",
  "$ref": "#/definitions/Value",
  "definitions": {
    "SectionValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      },
      "required": ["heading", "content"]
    },
    "SkillDocumentValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "sections": { "type": "object", "additionalProperties": { "$ref": "#/definitions/SectionValue" } }
      },
      "required": ["name", "scope", "path", "content", "sections"]
    },
    "Value": {
      "allOf": [{ "$ref": "#/definitions/SkillDocumentValue" }],
      "x-owner": "skills",
      "x-boundary": "Admits skill source through FileOwner and owns the Skill data value.",
      "x-invariants": ["A Skill FileBlock owns one skill document value."]
    }
  }
}
